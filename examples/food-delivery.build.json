    {
      "id": "w1",
      "name": "MarketplaceAPI",
      "x": 20,
      "y": 80,
      "code": "when SearchRestaurants {\n  read Restaurants by city_id many 50\n}\n\nwhen PlaceOrder {\n  read Menus by restaurant_id many 10\n  insert Orders\n  publish OrderEvents\n}"
    },
    {
      "id": "w2",
      "name": "Dispatch",
      "x": 300,
      "y": 320,
      "code": "when message OrderEvents {\n  read CourierLocations by zone_id many 20\n  update Orders\n}"
    },
    {
      "id": "w3",
      "name": "CourierAPI",
      "x": 20,
      "y": 500,
      "code": "when UpdateLocation {\n  upsert CourierLocations\n}"
    }
