{
  "kind": "loadbearing-build",
  "v": 1,
  "id": "b-checkout",
  "name": "Checkout system",
  "workloads": [
    {
      "id": "w1",
      "name": "Storefront",
      "x": 20,
      "y": 60,
      "code": "# Public API. Each \"when\" block is an endpoint.\nwhen Checkout {\n  call CartService.GetCart\n  if CartIsEmpty @4% {\n    error 400\n  }\n  read Customers by customer_id\n  insert Checkouts\n  call PaymentService.CreatePayment\n  if PaymentDeclined @6% {\n    update Checkouts\n    error 402\n  }\n  update Checkouts\n  publish OrderEvents\n}\n\nwhen ViewOrder {\n  read Checkouts by checkout_id\n  read Shipments by checkout_id\n}"
    },
    {
      "id": "w2",
      "name": "CartService",
      "x": 290,
      "y": 20,
      "code": "when GetCart {\n  read Carts by customer_id\n  for each item in Cart ~4 {\n    read Products by product_id\n  }\n}"
    },
    {
      "id": "w3",
      "name": "PaymentService",
      "x": 290,
      "y": 170,
      "code": "when CreatePayment {\n  parallel {\n    call FraudCheck.Score\n    read Payments by checkout_id\n  }\n  call PaymentGateway.Charge\n  insert Payments\n}"
    },
    {
      "id": "w4",
      "name": "FraudCheck",
      "x": 290,
      "y": 320,
      "code": "when Score {\n  read Customers by customer_id\n  compute 12ms\n}"
    },
    {
      "id": "w5",
      "name": "PaymentGateway",
      "x": 290,
      "y": 450,
      "external": true,
      "code": "# Runs outside your system. Use \"compute\" for the\n# response time you expect from the provider.\nwhen Charge {\n  compute 180ms\n}"
    },
    {
      "id": "w6",
      "name": "Fulfillment",
      "x": 290,
      "y": 600,
      "code": "when message OrderEvents {\n  read Checkouts by checkout_id\n  insert Shipments\n}"
    },
    {
      "id": "w7",
      "name": "ProductImport",
      "x": 20,
      "y": 400,
      "code": "when file ProductFeeds {\n  for each row in file {\n    upsert Products\n  }\n}"
    },
    {
      "id": "w8",
      "name": "NightlyReport",
      "x": 20,
      "y": 660,
      "code": "when schedule \"daily 02:00\" {\n  read Checkouts by status many 120k\n  insert Reports\n}"
    }
  ],
