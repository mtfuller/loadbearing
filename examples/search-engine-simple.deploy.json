{
  "kind": "loadbearing-deploy",
  "v": 1,
  "id": "dp-search-engine-simple",
  "name": "Single-region starter",
  "regions": [
    "use1"
  ],
  "peering": false,
  "externals": {},
  "compute": [
    {
      "id": "c-search-engine-simple",
      "name": "app",
      "type": "k8s",
      "regions": [
        "use1"
      ],
      "size": "Small",
      "min": 2,
      "max": 8,
      "workloads": [
        "SearchAPI",
        "Ranker",
        "Crawler",
        "Indexer"
      ]
    }
  ],
  "stores": [
    {
      "id": "s-search-engine-simple-0",
      "name": "content-db",
      "type": "doc",
      "regions": [
        "use1"
      ],
      "primary": "use1",
      "repl": "single",
      "readFrom": "nearest",
      "size": "Small",
      "shards": 1,
      "partitions": 12,
      "data": [
        "Documents"
      ]
    },
    {
      "id": "s-search-engine-simple-1",
      "name": "search-index",
      "type": "postgres",
      "regions": [
        "use1"
      ],
      "primary": "use1",
      "repl": "single",
      "readFrom": "nearest",
      "size": "Small",
      "shards": 1,
      "partitions": 12,
      "data": [
        "IndexSegments"
      ]
    },
    {
      "id": "s-search-engine-simple-2",
      "name": "index-queue",
      "type": "queue",
      "regions": [
        "use1"
      ],
      "primary": "use1",
      "repl": "single",
      "readFrom": "nearest",
      "size": "Small",
      "shards": 1,
      "partitions": 12,
      "data": [
        "IndexQueue"
      ]
    },
    {
      "id": "s-search-engine-simple-3",
      "name": "crawl-files",
      "type": "objects",
      "regions": [
        "use1"
      ],
      "primary": "use1",
      "repl": "single",
      "readFrom": "nearest",
      "size": "Small",
      "shards": 1,
      "partitions": 12,
      "data": [
        "CrawlPages"
      ]
    }
  ]
}
