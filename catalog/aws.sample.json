      },
      "latency": { "read": [3, 10], "write": [5, 16], "$comment": "median and p99 in ms; model assumptions, to be sanity-checked" },
      "limits": [],
      "pricing": { "source": "price-list-api" },
      "concepts": ["partition key", "global secondary index", "last writer wins", "strong vs eventual consistency"],
      "regions": "*"
    },
    {
